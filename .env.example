# --- Supabase (enables cloud auth, database storage & image uploads) ---
# Create a project at https://supabase.com , then paste the values from
# Project Settings -> API. Leave these blank to run fully on localStorage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI descriptions (optional, premium feature) ---
# Get a key from https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=
